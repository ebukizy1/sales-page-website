date unpredictably when the component happens to re-render. (https://react.dev/reference/rules/components-and-hooks-must-be-pure#components-and-hooks-must-be-idempotent).\n\n/Users/chukwumaemmanuel/Downloads/sales-page-polish copy 2/components/ui/sidebar.tsx:643:26\n  641 |   // Random width between 50 to 90%.\n  642 |   const width = React.useMemo(() => {\n> 643 |     return `${Math.floor(Math.random() * 40) + 50}%`;\n      |                          ^^^^^^^^^^^^^ Cannot call impure function\n  644 |   }, []);\n  645 |\n  646 |   return (",{"range":"2423","text":"2014"},"Replace `·id:·string;·product_id:·string;·label:·string;·value:·string;·sort_order:·number·` with `⏎··id:·string;⏎··product_id:·string;⏎··label:·string;⏎··value:·string;⏎··sort_order:·number;⏎`",{"range":"2424","text":"2425"},"Replace `·id:·string;·product_id:·string;·title:·string;·description:·string·|·null;·icon:·string·|·null;·sort_order:·number·` with `⏎··id:·string;⏎··product_id:·string;⏎··title:·string;⏎··description:·string·|·null;⏎··icon:·string·|·null;⏎··sort_order:·number;⏎`",{"range":"2426","text":"2427"},"Replace `·id:·string;·product_id:·string;·url:·string;·alt:·string·|·null;·sort_order:·number;·image_type:·string·|·null·` with `⏎··id:·string;⏎··product_id:·string;⏎··url:·string;⏎··alt:·string·|·null;⏎··sort_order:·number;⏎··image_type:·string·|·null;⏎`",{"range":"2428","text":"2429"},["2430","2431"],["2432"],["2433","2434"],["2435","2436"],["2437","2438"],["2439"],["2440","2441"],["2442"],["2443","2444"],["2445"],["2446","2447"],["2448"],[170,300],"\n  db,\n  type Product,\n  type Spec,\n  type Feature,\n  type GalleryImage,\n  type Package,\n  type SiteSettings,\n  type Offer,\n  type Review,\n  type FAQ,\n",[975,1001],"\n      setIsAdmin(null);\n      return;\n   ",[1016,1101],"\n      .from(\"user_roles\")\n      .select(\"role\")\n      .eq(\"user_id\", session.user.id)\n      .eq(\"role\", \"admin\")\n      ",[1317,1348],"\n      setMsg(error.message);\n      return;\n   ",[13