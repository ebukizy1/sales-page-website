suppressions":"1600"},{"ruleId":"850","severity":2,"message":"851","line":5,"column":75,"nodeType":"852","messageId":"853","endLine":5,"endColumn":78,"suggestions":"1601"},{"ruleId":"850","severity":2,"message":"851","line":19,"column":81,"nodeType":"852","messageId":"853","endLine":19,"endColumn":84,"suggestions":"1602"},{"ruleId":"850","severity":2,"message":"851","line":8,"column":28,"nodeType":"852","messageId":"853","endLine":8,"endColumn":31,"suggestions":"1603","suppressions":"1604"},{"ruleId":"850","severity":2,"message":"851","line":8,"column":63,"nodeType":"852","messageId":"853","endLine":8,"endColumn":66,"suggestions":"1605","suppressions":"1606"},{"ruleId":"850","severity":2,"message":"851","line":22,"column":28,"nodeType":"852","messageId":"853","endLine":22,"endColumn":31,"suggestions":"1607","suppressions":"1608"},{"ruleId":"850","severity":2,"message":"851","line":22,"column":63,"nodeType":"852","messageId":"853","endLine":22,"endColumn":66,"suggestions":"1609","suppressions":"1610"},"prettier/prettier","Replace `·db,·type·Product,·type·Spec,·type·Feature,·type·GalleryImage,·type·Package,·type·SiteSettings,·type·Offer,·type·Review,·type·FAQ·` with `⏎··db,⏎··type·Product,⏎··type·Spec,⏎··type·Feature,⏎··type·GalleryImage,⏎··type·Package,⏎··type·SiteSettings,⏎··type·Offer,⏎··type·Review,⏎··type·FAQ,⏎`","replace",{"range":"1611","text":"1612"},"Replace `·setIsAdmin(null);·return;` with `⏎······setIsAdmin(null);⏎······return;⏎···`",{"range":"1613","text":"1614"},"react-hooks/set-state-in-effect","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/Users/chukwumaemmanuel/Downloads/sales-page-polish copy 2/app/admin/page.tsx:24:21\n  22 |\n  23 |   useEffect(() => {\n> 24 |     if (!session) { setIsAdmin(null); return; }\n     |                     ^^^^^^^^^^ Avoid calling setState() directly within an effect\n  25 |     supabase.from(\"user_roles\").select(\"role\").eq(\"user_id\", session.user.id).eq(\"role\", \"admin\").maybeSingle()\n  26 |       .then(({ data }) => setIsAdmin(!!data));\n  27 |   }, [session]);","Replace `.from(\"user_roles\").select(\"role\").eq(\"user_id\",·session.user.id).eq(\"role\",·\"admin\")` with `⏎······.from(\"user_roles\")⏎······.select(\"role\")⏎······.eq(\"user_id\",·session.user.id)⏎······.eq(\"role\",·\"admin\")⏎······`",{"range":"1615","text":"1616"},"Replace `·setMsg(error.message);·return;` with `⏎······setMsg(error.message);⏎······return;⏎···`",{"range":"1617","text":"1618"},"Replace `·setIsAdmin(true);·setMsg(\"You·are·now·admin.\");·}` with `⏎······setIsAdmin(true);⏎······setMsg(\"You·are·now·admin.\");`",{"range":"1619","text":"1620"},"Insert `·}`","insert",{"range":"1621","text":"1622"},"Replace `·onClick={claimAdmin}·className=\"mt-5·rounded-xl·bg-emerald-500·px-6·py-3·font-bold·text-white\"` with `⏎············onClick={claimAdmin}⏎············className=\"mt-5·rounded-xl·bg-emerald-500·px-6·py-3·font-bold·text-white\"⏎··········`",{"range":"1623","text":"1624"},"Replace `·onClick={()·=>·supabase.auth.signOut()}·className=\"mt-4·block·w-full·text-xs·underline\">Sign·out` with `⏎············onClick={()·=>·supabase.auth.signOut()}⏎············className=\"mt-4·block·w-full·text-xs·underline\"⏎··········>⏎············Sign·out⏎··········`",{"range":"1625","text":"1626"},"Replace `Home` with `⏎··············Home⏎············`",{"range":"1627","text":"1628"},"Replace `Offers` with `⏎··············Offers⏎············`",{"range":"1629","text":"1630"},"Replace `·onClick={()·=>·supabase.auth.signOut()}·className=\"rounded-lg·border·px-3·py-1.5·font-semibold\">Sign·out` with `⏎··············onClick={()·=>·supabase.auth.signOut()}⏎··············className=\"rounded-lg·border·px-3·py-1.5·font-semibold\"⏎············>⏎··············Sign·out⏎············`",{"range":"1631","text":"1632"},"Replace `\"products\",\"offers\",` with `·\"products\",·\"offers\",·`",{"range":"1633","text":"1634"},"Replace `·key={t}` with `⏎················key={t}⏎···············`",{"range":"1635","text":"1636"},"Insert `⏎··············`",{"range":"1637","text":"1638"},"Replace `·customer_name:·string;·phone:·string;` with `⏎··customer_name:·string;⏎··phone:·string;⏎·`",{"range":"1639","text":"1640"},"Replace `·state:·string;·package_label:·string;` with `⏎··state:·string;⏎··package_label:·string;⏎·`",{"range":"1641","text":"1642"},"Replace `·status:·string;` with `⏎··status:·string;⏎·`",{"range":"1643","text":"1644"},"Replace `\"pending\",\"confirmed\",\"processing\",\"shipped\",\"delivered\",\"cancelled\",\"new\",\"called\",\"dispatched\"` with `⏎··\"pending\",⏎··\"confirmed\",⏎··\"processing\",⏎··\"shipped\",⏎··\"delivered\",⏎··\"cancelled\",⏎··\"new\",⏎··\"called\",⏎··\"dispatched\",⏎`",{"range":"1645","text":"1646"},"Replace `.from(\"orders\").select(\"*\").order(\"created_at\",·{·ascending:·false·})` with `⏎······.from(\"orders\")⏎······.select(\"*\")⏎······.order(\"created_at\",·{·ascending:·false·})⏎······`",{"range":"1647","text":"1648"},"Replace `·setOrders((data·as·Order[])·??·[]);·setLoading(false);` with `⏎········setOrders((data·as·Order[])·??·[]);⏎········setLoading(false);⏎·····`",{"range":"1649","text":"1650"},"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management 