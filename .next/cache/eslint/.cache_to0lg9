g | null;\n  icon: string | null;\n  sort_order: number;\n",[2034,2146],"\n  id: string;\n  product_id: string;\n  url: string;\n  alt: string | null;\n  sort_order: number;\n  image_type: string | null;\n",{"messageId":"2449","fix":"2461","desc":"2451"},{"messageId":"2452","fix":"2462","desc":"2454"},{"kind":"2463","justification":"2014"},{"messageId":"2449","fix":"2464","desc":"2451"},{"messageId":"2452","fix":"2465","desc":"2454"},{"messageId":"2449","fix":"2466","desc":"2451"},{"messageId":"2452","fix":"2467","desc":"2454"},{"messageId":"2449","fix":"2468","desc":"2451"},{"messageId":"2452","fix":"2469","desc":"2454"},{"kind":"2463","justification":"2014"},{"messageId":"2449","fix":"2470","desc":"2451"},{"messageId":"2452","fix":"2471","desc":"2454"},{"kind":"2463","justification":"2014"},{"messageId":"2449","fix":"2472","desc":"2451"},{"messageId":"2452","fix":"2473","desc":"2454"},{"kind":"2463","justification":"2014"},{"messageId":"2449","fix":"2474","desc":"2451"},{"messageId":"2452","fix":"2475","desc":"2454"},{"kind":"2463","justification":"2014"},"suggestUnknown",{"range":"2476","text":"2477"},"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct.","suggestNever",{"range":"2478","text":"2479"},"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of.",{"range":"2480","text":"2477"},{"range":"2481","text":"2479"},{"range":"2482","text":"2477"},{"range":"2483","text":"2479"},{"range":"2484","text":"2477"},{"range":"2485","text":"2479"},{"range":"2486","text":"2477"},{"range":"2487","text":"2479"},"directive",{"range":"2488","text":"2477"},{"range":"2489","text":"2479"},{"range":"2490","text":"2477"},{"range":"2491","text":"2479"},{"range":"2492","text":"2477"},{"range":"2493","text":"2479"},{"range":"2494","text":"2477"},{"range":"2495","text":"2479"},{"range":"2496","text":"2477"},{"range":"2497","text":"2479"},{"range":"2498","text":"2477"},{"range":"